    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net10.0</TargetFramework>
    <ProjectGuid>a1b2c3d4-e5f6-7a8b-9a0b-c1d2e3f4a5b6</ProjectGuid>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>